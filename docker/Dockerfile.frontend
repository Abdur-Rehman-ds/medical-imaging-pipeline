# Frontend image — SRS Section 10.1 (separate frontend image).
# Stage 1: build the Vite bundle with the exact locked deps (npm ci).
FROM node:22-slim AS build
WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# Stage 2: serve static files via nginx; /v1 proxied to the api service
# (see docker/nginx.conf), matching the vite dev proxy.
FROM nginx:1.27-alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /build/dist /usr/share/nginx/html
EXPOSE 80
