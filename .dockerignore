**/__pycache__
*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
data/
models/
checkpoints/
*.pt
*.pth
*.ckpt
*.onnx
*.nii
*.nii.gz
wandb/
mlruns/
notebooks/
docs/
frontend/node_modules
frontend/dist
.env
*.key
*.log
*.bak-v1
